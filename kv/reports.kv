<ReportsScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: dp(20)
        spacing: dp(15)
        BoxLayout:
            size_hint_y: None
            height: dp(50)
            Button:
                text: 'Назад'
                size_hint_x: None
                width: dp(60)
                background_color: 0.8,0.8,0.8,1
                color: 0,0,0,1
                on_release: app.root.current = 'main'
            Label:
                text: 'Отчёты'
                color: 0,0,0,1
        Label:
            id: info_label
            text: 'Загрузка...'
            color: 0,0,0,1
            size_hint_y: None
            height: dp(30)
        BoxLayout:
            id: reports_container
            orientation: 'vertical'
            size_hint_y: None
            height: self.minimum_height