<CreateTicketScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: dp(20)
        spacing: dp(15)
        BoxLayout:
            size_hint_y: None
            height: dp(50)
            Button:
                text: 'Назад'
                size_hint_x: None
                width: dp(60)
                background_color: 0.8,0.8,0.8,1
                color: 0,0,0,1
                on_release: root.go_back()
            Label:
                text: 'Создание заявки'
                color: 0,0,0,1
        Spinner:
            id: type_spinner
            text: 'Выберите тип проблемы'
            values: ['Инцидент', 'Запрос', 'Аппаратная проблема', 'Проблема с ПО', 'Сеть']
            background_color: 0.9,0.9,0.9,1
            color: 0,0,0,1
            size_hint_y: None
            height: dp(45)
        TextInput:
            id: title_input
            hint_text: 'Заголовок проблемы'
            background_color: 0.9,0.9,0.9,1
            foreground_color: 0,0,0,1
            hint_text_color: 0.6,0.6,0.6,1
            size_hint_y: None
            height: dp(45)
        TextInput:
            id: desc_input
            hint_text: 'Опишите проблему подробно'
            background_color: 0.9,0.9,0.9,1
            foreground_color: 0,0,0,1
            hint_text_color: 0.6,0.6,0.6,1
            multiline: True
            size_hint_y: 0.4
        Button:
            text: 'Прикрепить файл'
            background_color: 0.8,0.8,0.8,1
            color: 0,0,0,1
            size_hint_y: None
            height: dp(45)
        Button:
            text: 'Отправить'
            background_color: 0.8,0.8,0.8,1
            color: 0,0,0,1
            size_hint_y: None
            height: dp(45)
            on_release: root.submit_ticket()